# postmarketOS on the Nook HD+: what pmbootstrap's kconfig check (category
# "default") asks for on top of omap_bn_ovation_defconfig.
#   make omap_bn_ovation_defconfig ovation_pmos.config
CONFIG_USER_NS=y
# systemd sets pids.max on every unit
CONFIG_CGROUP_PIDS=y
CONFIG_PSI=y
CONFIG_UEVENT_HELPER=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_PATH=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_LSM=y
CONFIG_DEBUG_INFO_DWARF5=y
# BTF needs the debug info in vmlinux, not in .dwo files
# CONFIG_DEBUG_INFO_SPLIT is not set
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_DECOMPRESS=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_XTS=y
CONFIG_NLS_ASCII=y
CONFIG_UDMABUF=y
# postmarketos-zram-swap asks for zstd
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_NULL_TTY=m
